{
  "name": "brat-lang",
  "displayName": "BRAT Language Support",
  "description": "Syntax highlighting, snippets and language configuration for BRAT (.brat, .bri).",
  "version": "0.7.0",
  "publisher": "brat-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/denionis23/brat.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "brat",
        "aliases": [
          "BRAT",
          "brat"
        ],
        "extensions": [
          ".brat",
          ".bri"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "brat",
        "scopeName": "source.brat",
        "path": "./syntaxes/brat.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "brat",
        "path": "./snippets/brat.code-snippets"
      }
    ]
  }
}
